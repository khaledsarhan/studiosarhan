---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import InstagramIcon from '../components/InstagramIcon.astro';
import MailIcon from '../components/MailIcon.astro';
import { legalReady } from '../lib/legal';
import site from '../data/site.json';
import { url } from '../lib/url';

const entry = (await getEntry('pages', 'about'))!;
const about = entry.data;
const { Content } = await render(entry);
const formEndpoint = site.contactFormEndpoint?.trim();
---
<Base title={about.title} description={about.description} current="about">
  <section class="wrap section split">
    <div class="portrait frame">
      <i></i><i></i><i></i><i></i>
      <img src={url('/assets/img/portrait-dark.svg')} width="766" height="971" alt={`Line drawing of ${site.photographer}`} />
    </div>
    <div class="copy">
      <span class="kicker">About</span>
      <h1 style="font-size: clamp(38px, 4.6vw, 64px)">{about.heading ?? site.photographer}</h1>
      <div class="prose"><Content /></div>
    </div>
  </section>

  {site.offerCommissions && about.services.length > 0 && (
    <section class="band">
      <div class="wrap section">
        <div class="section-head"><h2>Commissions</h2></div>
        <div class="services">
          {about.services.map((s, i) => (
            <div>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="contact" class="wrap section contact">
    <div class="intro">
      <span class="kicker">Contact</span>
      <h2>{site.offerCommissions ? "Let's make something" : 'Get in touch'}</h2>
      {site.offerCommissions
        ? <p>Tell me what you have in mind and I'll reply with availability and next steps. Use the form, or write to me directly.</p>
        : <p>Questions about a photograph, prints, a collaboration, or just want to say hello? Use the form, or write to me directly.</p>}
      <div class="contact-links">
        <a class="ig-link" href={`mailto:${site.email}`}><MailIcon /> {site.email}</a>
        <a class="ig-link" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener"><InstagramIcon /> @{site.instagram} on Instagram</a>
      </div>
    </div>
    {formEndpoint && (
      <form class="enquiry" action={formEndpoint} method="POST" data-enquiry>
        <input type="hidden" name="_subject" value={site.offerCommissions ? 'New enquiry from studiosarhan.com' : 'New message from studiosarhan.com'} />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="field">Name<input type="text" name="name" autocomplete="name" required /></label>
        <label class="field">Email<input type="email" name="email" autocomplete="email" required /></label>
        {site.offerCommissions ? (
          <>
            <label class="field">Type of shoot
              <select name="type">
                {about.services.map((s) => <option>{s.title}</option>)}
                <option>Something else</option>
              </select>
            </label>
            <label class="field">Preferred date<input type="date" name="date" /></label>
          </>
        ) : (
          <label class="field wide">Subject
            <select name="topic">
              {(site.contactSubjects?.length ? site.contactSubjects : ['General question']).map((s, i) => (
                <option selected={i === 0}>{s}</option>
              ))}
            </select>
          </label>
        )}
        <label class="field wide">Message<textarea name="message" rows="5" required></textarea></label>
        <div class="wide form-foot">
          <button type="submit" class="btn solid">{site.offerCommissions ? 'Send enquiry' : 'Send message'}</button>
          <p class="form-note">Your message is sent through Formspree and only used to reply to you.{legalReady && <> <a href={url('/privacy/')} style="color: var(--muted); text-decoration: underline">Privacy</a></>}</p>
        </div>
        <p class="wide form-status" role="status" aria-live="polite" data-status hidden></p>
      </form>
    )}
    {formEndpoint && (
      <div class="enquiry-sent" data-sent hidden tabindex="-1">
        <span class="kicker">Thank you</span>
        <h3>Your message is on its way</h3>
        <p>I'll get back to you soon, usually within a couple of days.</p>
      </div>
    )}
  </section>
</Base>

<script>
  // Sends the enquiry without leaving the page and shows a thank-you message.
  // Without JavaScript the form still works and Formspree shows its own confirmation page.
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  const sent = document.querySelector<HTMLElement>('[data-sent]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent;
    button.disabled = true;
    button.textContent = 'Sending…';
    if (status) status.hidden = true;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      if (sent) { sent.hidden = false; sent.focus(); }
    } catch {
      if (status) {
        status.hidden = false;
        status.textContent = 'Sorry, the message could not be sent. Please try again, or email hello@studiosarhan.com.';
      }
      button.disabled = false;
      button.textContent = label;
    }
  });
</script>
