---
// Full-screen viewer with zoom, built on PhotoSwipe (src/vendor/photoswipe, MIT).
// Photos on the page open it via links with data-lightbox="<index>";
// a button with data-lightbox-start opens it at the first photo.
// Zoom: pinch on phones; click, double-click or scroll wheel on desktop; drag to move around.
import '../vendor/photoswipe/photoswipe.css';

interface Props {
  title: string;
  slides: { src: string; width: number; height: number; thumb: string; alt: string; caption: string }[];
}
const { title, slides } = Astro.props;
---
<div hidden data-viewer data-title={title} data-slides={JSON.stringify(slides)}></div>

<script>
  import PhotoSwipeLightbox from '../vendor/photoswipe/photoswipe-lightbox.esm.min.js';

  type Slide = { src: string; width: number; height: number; thumb: string; alt: string; caption: string };
  const holder = document.querySelector<HTMLElement>('[data-viewer]');

  if (holder) {
    const slides: Slide[] = JSON.parse(holder.dataset.slides || '[]');
    const title = holder.dataset.title || '';
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]'));

    const lightbox = new PhotoSwipeLightbox({
      dataSource: slides.map((s) => ({ src: s.src, width: s.width, height: s.height, alt: s.alt, msrc: s.thumb })),
      pswpModule: () => import('../vendor/photoswipe/photoswipe.esm.min.js'),
      bgOpacity: 1,
      showHideAnimationType: 'zoom',
      // Click / tap the photo to zoom in, again to zoom out. Double-tap also zooms.
      imageClickAction: 'zoom',
      tapAction: 'toggle-controls',
      doubleTapAction: 'zoom',
      bgClickAction: 'close',
      wheelToZoom: true,
      // First zoom step shows the photo at full resolution (or 2x on smaller screens).
      secondaryZoomLevel: (zoom: any) => Math.max(zoom.initial * 2, Math.min(1, zoom.initial * 3)),
      maxZoomLevel: (zoom: any) => Math.max(zoom.initial * 4, 1.5),
      closeOnVerticalDrag: true,
      // Room for the title bar above and the caption + thumbnails below.
      paddingFn: (viewport: { x: number; y: number }) => {
        const phone = viewport.x < 640;
        return { top: phone ? 56 : 64, bottom: slides.length > 1 ? (phone ? 96 : 118) : 56, left: phone ? 0 : 72, right: phone ? 0 : 72 };
      },
      arrowPrevTitle: 'Previous photograph',
      arrowNextTitle: 'Next photograph',
      closeTitle: 'Close viewer',
      zoomTitle: 'Zoom in or out',
      errorMsg: 'This photograph could not be loaded.',
      indexIndicatorSep: ' / ',
    });

    // The photo on the page that the viewer opens from and closes back to.
    lightbox.addFilter('thumbEl', (el: any, _data: any, index: number) => links.find((a) => Number(a.dataset.lightbox) === index)?.querySelector('img') || el);
    lightbox.addFilter('placeholderSrc', (src: any, slide: any) => {
      const img = links.find((a) => Number(a.dataset.lightbox) === slide.index)?.querySelector('img');
      return img?.currentSrc || src;
    });

    lightbox.on('uiRegister', () => {
      const pswp = lightbox.pswp as any;

      // Series title, top left
      pswp.ui.registerElement({
        name: 'series-title',
        order: 5,
        isButton: false,
        appendTo: 'bar',
        onInit: (el: HTMLElement) => { el.textContent = title; },
      });

      // Caption under the photo
      pswp.ui.registerElement({
        name: 'caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        onInit: (el: HTMLElement) => {
          el.setAttribute('aria-live', 'polite');
          pswp.on('change', () => { el.textContent = slides[pswp.currIndex]?.caption || ''; });
        },
      });

      // Thumbnail strip
      if (slides.length > 1) {
        pswp.ui.registerElement({
          name: 'thumbs',
          order: 10,
          isButton: false,
          appendTo: 'root',
          onInit: (el: HTMLElement) => {
            const buttons = slides.map((s, i) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.setAttribute('aria-label', `Show photograph ${i + 1}`);
              const img = document.createElement('img');
              img.src = s.thumb;
              img.alt = '';
              b.appendChild(img);
              b.addEventListener('click', () => pswp.goTo(i));
              el.appendChild(b);
              return b;
            });
            pswp.on('change', () => {
              buttons.forEach((b, i) => b.setAttribute('aria-current', String(i === pswp.currIndex)));
              buttons[pswp.currIndex]?.scrollIntoView({ block: 'nearest', inline: 'center' });
            });
          },
        });
      }
    });

    // Keep a shareable link to the photo being viewed, e.g. /quiet-metropolis/#photo-3
    lightbox.on('change', () => {
      const i = (lightbox.pswp as any)?.currIndex ?? 0;
      history.replaceState(null, '', `#photo-${i + 1}`);
    });
    lightbox.on('close', () => history.replaceState(null, '', location.pathname + location.search));

    lightbox.init();

    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        lightbox.loadAndOpen(Number(a.dataset.lightbox));
      }),
    );
    document.querySelectorAll<HTMLElement>('[data-lightbox-start]').forEach((b) =>
      b.addEventListener('click', (e) => { e.preventDefault(); lightbox.loadAndOpen(0); }),
    );

    const m = location.hash.match(/^#photo-(\d+)$/);
    if (m) {
      const i = Number(m[1]) - 1;
      if (i >= 0 && i < slides.length) lightbox.loadAndOpen(i);
    }

  }
</script>
