---
// Full-screen viewer. Photos on the page open it via links with data-lightbox="<index>".
interface Props {
  title: string;
  slides: { src: string; thumb: string; alt: string; caption: string }[];
}
const { title, slides } = Astro.props;
---
<dialog class="lightbox" aria-label={`${title}, full-screen viewer`} data-slides={JSON.stringify(slides)}>
  <div class="lb-top">
    <span class="t">{title}</span>
    <span class="count" aria-live="polite"><b data-lb-current>01</b> / {String(slides.length).padStart(2, '0')}</span>
    <button type="button" class="icon-btn" data-lb-close aria-label="Close viewer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
    </button>
  </div>
  <div class="lb-stage">
    <img data-lb-img alt="" />
    {slides.length > 1 && (
      <>
        <button type="button" class="icon-btn lb-arrow prev" data-lb-prev aria-label="Previous photograph">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button type="button" class="icon-btn lb-arrow next" data-lb-next aria-label="Next photograph">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </>
    )}
  </div>
  <p class="lb-caption" data-lb-caption></p>
  {slides.length > 1 && (
    <div class="lb-thumbs">
      {slides.map((s, i) => (
        <button type="button" data-lb-go={i} aria-label={`Show photograph ${i + 1}`} aria-current="false">
          <img src={s.thumb} alt="" loading="lazy" />
        </button>
      ))}
    </div>
  )}
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  if (dialog) {
    type Slide = { src: string; thumb: string; alt: string; caption: string };
    const slides: Slide[] = JSON.parse(dialog.dataset.slides || '[]');
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const cur = dialog.querySelector<HTMLElement>('[data-lb-current]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]');
    const thumbs = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-lb-go]'));
    let at = 0;
    let lastFocus: HTMLElement | null = null;

    const preload = (i: number) => { if (slides[i]) { const p = new Image(); p.src = slides[i].src; } };

    const show = (i: number) => {
      at = Math.max(0, Math.min(slides.length - 1, i));
      const s = slides[at];
      img.classList.add('loading');
      img.onload = () => img.classList.remove('loading');
      img.src = s.src;
      img.alt = s.alt;
      cap.textContent = s.caption;
      cur.textContent = String(at + 1).padStart(2, '0');
      if (prev) prev.disabled = at === 0;
      if (next) next.disabled = at === slides.length - 1;
      thumbs.forEach((t, k) => {
        t.setAttribute('aria-current', String(k === at));
        if (k === at) t.scrollIntoView({ block: 'nearest', inline: 'center' });
      });
      preload(at + 1);
      preload(at - 1);
      history.replaceState(null, '', `#photo-${at + 1}`);
    };

    const open = (i: number) => {
      lastFocus = document.activeElement as HTMLElement;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      show(i);
    };

    const close = () => dialog.close();
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      history.replaceState(null, '', location.pathname + location.search);
      lastFocus?.focus();
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        open(Number(a.dataset.lightbox));
      });
    });
    document.querySelectorAll<HTMLElement>('[data-lightbox-start]').forEach((b) =>
      b.addEventListener('click', (e) => { e.preventDefault(); open(0); }),
    );

    dialog.querySelector('[data-lb-close]')?.addEventListener('click', close);
    prev?.addEventListener('click', () => show(at - 1));
    next?.addEventListener('click', () => show(at + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.lbGo))));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
    });

    // swipe on phones
    let x0: number | null = null;
    const stage = dialog.querySelector<HTMLElement>('.lb-stage')!;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1));
    });
    // click on the dark area beside the photo closes the viewer
    stage.addEventListener('click', (e) => { if (e.target === stage) close(); });

    // a link like /quiet-metropolis/#photo-3 opens that photo directly
    const m = location.hash.match(/^#photo-(\d+)$/);
    if (m) open(Number(m[1]) - 1);
  }
</script>
