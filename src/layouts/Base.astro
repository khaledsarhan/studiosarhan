---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative URL of the share image. */
  image?: string;
  overlayHeader?: boolean;
  current?: 'work' | 'about' | null;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description = '', image, overlayHeader = false, current = null, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image ?? url('/assets/img/og.png'), Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#000000" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href={url('/assets/img/favicon.svg')} />
  <link rel="icon" type="image/png" sizes="192x192" href={url('/assets/img/icon-192.png')} />
  <link rel="apple-touch-icon" href={url('/assets/img/apple-touch-icon.png')} />
  <link rel="sitemap" href={url("/sitemap.xml")} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImage} />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header overlay={overlayHeader} current={current} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <slot name="end" />
</body>
</html>
