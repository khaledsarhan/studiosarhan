---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../data/site.json';
import { getProjects, layoutRows, countLabel, widthsFor, type Project } from '../lib/projects';
import { url } from '../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { project: project.id },
    props: { project, index: i, total: projects.length, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props { project: Project; index: number; total: number; next: Project }
const { project, index, total, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Full-size versions for the viewer, small ones for its thumbnail strip.
const slides = await Promise.all(
  data.photos.map(async (ph) => {
    const full = await getImage({ src: ph.image, width: Math.min(ph.image.width, 2400), format: 'webp', quality: 86 });
    const thumb = await getImage({ src: ph.image, width: 160, format: 'webp', quality: 70 });
    return { src: full.src, thumb: thumb.src, alt: ph.alt, caption: [ph.title, ph.caption].filter(Boolean).join(' · ') };
  }),
);
const share = await getImage({ src: data.cover, width: 1200, format: 'jpg', quality: 80 });
const rows = layoutRows(data.photos, Boolean(data.note));
const pad = (n: number) => String(n).padStart(2, '0');
const showNext = total > 1 && next.id !== project.id;
---
<Base title={`${data.title} – ${site.name}`} description={data.summary} image={share.src} current="work">
  <div class="wrap">
    <section class="project-head">
      <div class="title">
        <a class="back" href={url('/#work')}>← All series</a>
        <span class="kicker">Series {pad(index + 1)} / {pad(total)}</span>
        <h1>{data.title}</h1>
      </div>
      <div class="about">
        <div class="prose"><Content /></div>
        <dl class="facts">
          <div><dt>Photographs</dt><dd>{data.photos.length}</dd></div>
          {data.year && <div><dt>Year</dt><dd>{data.year}</dd></div>}
          {data.place && <div><dt>Place</dt><dd>{data.place}</dd></div>}
        </dl>
      </div>
    </section>

    <section class="sequence" aria-label="Photographs">
      {rows.map((row, r) => {
        if (row.kind === 'pair') {
          return (
            <div class="pair">
              {row.items.map(({ photo, index: i }) => (
                <Shot photo={photo} index={i} full={slides[i].src} sizes="(max-width: 900px) 100vw, 50vw" />
              ))}
            </div>
          );
        }
        if (row.kind === 'note') {
          const { photo, index: i } = row.items[0];
          return (
            <div class="with-note">
              <Shot photo={photo} index={i} full={slides[i].src} sizes="(max-width: 900px) 100vw, 66vw" />
              <blockquote class="note"><p>{data.note}</p></blockquote>
            </div>
          );
        }
        const { photo, index: i } = row.items[0];
        return (
          <div class={row.kind === 'single' ? 'single' : undefined}>
            <Shot photo={photo} index={i} full={slides[i].src} sizes={row.kind === 'single' ? '(max-width: 960px) 100vw, 920px' : '100vw'} eager={r === 0} />
          </div>
        );
      })}
    </section>

    <section class="project-end">
      <div class="bar">
        <button type="button" class="btn" data-lightbox-start>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
          View full screen
        </button>
        <span>{countLabel(data.photos.length)} · More on <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener" style="color:#cfcfcf">Instagram</a></span>
      </div>
      {showNext && (
        <a class="next" href={url(`/${next.id}/`)}>
          <div class="img">
            <Image src={next.data.cover} alt={next.data.coverAlt} widths={widthsFor(next.data.cover, [640, 1024, 1600])} sizes="(max-width: 760px) 100vw, 50vw" format="webp" quality={78} style={`object-position:${next.data.coverPosition}`} />
          </div>
          <div class="txt">
            <span class="kicker plain">Next series</span>
            <b>{next.data.title} →</b>
            <p>{next.data.summary}</p>
          </div>
        </a>
      )}
    </section>
  </div>

  <Lightbox slot="end" title={data.title} slides={slides} />
</Base>
